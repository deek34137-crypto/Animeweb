# Prisma Environment Variables (example)
# Replace with your actual connection strings
# DATABASE_URL format: postgresql://USER:PASS@HOST:PORT/DATABASE?options
DATABASE_URL="postgresql://username:password@host:port/database"
DIRECT_URL="postgresql://username:password@host:port/database"

# Canonical Application URLs
# Production deployments must provide environment-specific values here.
# Do not use localhost values in production.
APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Logging (optional, defaults to 'info' in production, 'debug' in development)
# LOG_LEVEL="info"

# Auth secret for JWT or session handling
AUTH_SECRET="your-secret-key"

# Optional: Redis Configuration (Required if FLAG_USE_NEW_CACHE=true)
# REDIS_URL="redis://your-redis-host:6379"

# Optional: Meilisearch Configuration (Required if FLAG_ENABLE_SEARCH_FALLBACK=true)
# MEILISEARCH_HOST="http://your-meilisearch-host:7700"
# MEILISEARCH_KEY="your-meilisearch-key"

# Optional: AWS S3 Configuration (Required if S3 features enabled)
# AWS_ACCESS_KEY_ID="your-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
# CDN_BUCKET="your-cdn-bucket-name"
# AWS_REGION="us-east-1"

# Web Push VAPID Configuration (example)
WEB_PUSH_EMAIL="mailto:your-email@example.com"
RAPIDAPI_KEY="your_key_here"
RAPIDAPI_HOST="streaming-availability.p.rapidapi.com"

# Feature Flags (all default to false)
# FLAG_ENABLE_TORRENTS=false    # Enable Nyaa.si torrent search + TorrServer streaming

# AniList OAuth client configuration
ANILIST_CLIENT_ID=""
ANILIST_CLIENT_SECRET=""

# MyAnimeList OAuth client configuration
MAL_CLIENT_ID=""
MAL_CLIENT_SECRET=""
